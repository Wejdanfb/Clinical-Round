# Copy to .env for local use (the .env file is git-ignored - never commit it).

# Long random value. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Password you use to sign in. Leave empty ONLY for local use on your own
# computer; it is mandatory when hosted (Render).
APP_PASSWORD=

# Leave empty locally to use a SQLite file in ./instance.
# On Render this is filled in automatically from the Render PostgreSQL database.
DATABASE_URL=

# Retention policy (days)
COMPLETED_ROUND_RETENTION_DAYS=7
INACTIVE_ROUND_DAYS=30
